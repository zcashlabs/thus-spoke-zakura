+// parse version 7 (NuTachyon) transaction data after the nVersionGroupId field.
+func (tx *Transaction) parseV7(data []byte) ([]byte, error) {
+	s := bytestring.String(data)
+	var err error
+	if !s.ReadUint32(&tx.consensusBranchID) {
+		return nil, errors.New("could not read nConsensusBranchId")
+	}
+	if tx.nVersionGroupID != TACHYON_V7_VERSION_GROUP_ID {
+		return nil, fmt.Errorf("version group ID 0x%08X must be 0x%08X",
+			tx.nVersionGroupID, TACHYON_V7_VERSION_GROUP_ID)
+	}
+	if !s.Skip(4) {
+		return nil, errors.New("could not skip nLockTime")
+	}
+	if !s.Skip(4) {
+		return nil, errors.New("could not skip nExpiryHeight")
+	}
+	if !s.Skip(8) {
+		return nil, errors.New("could not skip zip233Amount")
+	}
+	s, err = tx.ParseTransparent([]byte(s))
+	if err != nil {
+		return nil, err
+	}
+
+	s, err = tx.parseSaplingBundle([]byte(s))
+	if err != nil {
+		return nil, err
+	}
+
+	var orchardActions []action
+	s, orchardActions, err = parseOrchardActionShapeBundle([]byte(s), "Orchard")
+	if err != nil {
+		return nil, err
+	}
+	tx.orchardActions = orchardActions
+
+	var ironwoodActions []action
+	s, ironwoodActions, err = parseOrchardActionShapeBundle([]byte(s), "Ironwood")
+	if err != nil {
+		return nil, err
+	}
+	tx.ironwoodActions = ironwoodActions
+
+	s, err = parseTachyonBundle([]byte(s))
+	if err != nil {
+		return nil, err
+	}
+
+	return s, nil
+}
+
+const tachyonProofSizeCompressed = 23000
+
+func parseTachyonBundle(data []byte) ([]byte, error) {
+	s := bytestring.String(data)
+	var stateByte byte
+	if !s.ReadByte(&stateByte) {
+		return nil, errors.New("could not read tachyonBundleState")
+	}
+	if stateByte == 0 {
+		return s, nil
+	}
+	if stateByte != 1 && stateByte != 2 {
+		return nil, fmt.Errorf("invalid tachyonBundleState: 0x%02x", stateByte)
+	}
+	// valueBalance (8 bytes)
+	if !s.Skip(8) {
+		return nil, errors.New("could not skip tachyon valueBalance")
+	}
+	var nActions int
+	if !s.ReadCompactSize(&nActions) {
+		return nil, errors.New("could not read tachyon nActions")
+	}
+	// descriptors (64 bytes each: 32B cv + 32B rk) + feeMaxCommitment (32B) + signatures (64B each) + bindingSig (64B)
+	if !s.Skip(64*nActions + 32 + 64*nActions + 64) {
+		return nil, errors.New("could not skip tachyon actions and signatures")
+	}
+	var nMemo int
+	if !s.ReadCompactSize(&nMemo) {
+		return nil, errors.New("could not read tachyon nMemo")
+	}
+	if !s.Skip(nMemo) {
+		return nil, errors.New("could not skip tachyon memo")
+	}
+	if stateByte == 1 {
+		// ProofStamp: fee (8B) + coveredActions (32B) + anchor (32B) + tachygramSet (32B)
+		if !s.Skip(8 + 32 + 32 + 32) {
+			return nil, errors.New("could not skip tachyon ProofStamp header")
+		}
+		var nTachygrams int
+		if !s.ReadCompactSize(&nTachygrams) {
+			return nil, errors.New("could not read tachyon nTachygrams")
+		}
+		if !s.Skip(32*nTachygrams + tachyonProofSizeCompressed) {
+			return nil, errors.New("could not skip tachyon tachygrams and proof")
+		}
+	} else {
+		// PointerStamp: fee (8B) + aggregateId wtxid (64B)
+		if !s.Skip(8 + 64) {
+			return nil, errors.New("could not skip tachyon PointerStamp")
+		}
+	}
+	return s, nil
+}
