{
  "name": "@zcashlabs/thsjs",
  "version": "0.1.0",
  "description": "Start, control and clean up isolated THS Regtest sandboxes from JavaScript tests.",
  "license": "MIT",
  "type": "module",
  "engines": { "node": ">=22.23.4" },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zcashlabs/thus-spoke-zakura.git",
    "directory": "packages/thsjs"
  },
  "files": ["dist/index.js", "dist/index.d.ts", "LICENSE", "README.md"],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "browser": null,
      "node": {
        "import": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build",
    "test": "npm run build && node --test tests/*.test.mjs"
  },
  "devDependencies": {
    "@types/node": "22.20.3",
    "typescript": "6.0.3"
  },
  "publishConfig": { "access": "public" }
}
